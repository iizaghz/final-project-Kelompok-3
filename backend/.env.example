PORT=3000
FRONTEND_URL=http://localhost:5173

# JWT Secret untuk autentikasi Kasir & Admin
JWT_SECRET=

# ====================================================================
# DATABASE CONFIGURATION (Pilih salah satu: Supabase atau PostgreSQL Lokal)
# ====================================================================

# Opsi 1: Supabase Cloud PostgreSQL (https://supabase.com)
SUPABASE_URL=
SUPABASE_KEY=

# Opsi 2: PostgreSQL Lokal (pgAdmin / Docker / PostgreSQL Service)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=

# Catatan: Jika kedua opsi di atas dikosongkan, backend otomatis berjalan 
# dalam mode in-memory (mock data) sehingga tetap dapat diuji coba secara langsung.

# ====================================================================
# PAYMENT GATEWAY: iPaymu QRIS (Sandbox: https://sandbox.ipaymu.com)
# ====================================================================
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_URL=
IPAYMU_NOTIFY_URL=

